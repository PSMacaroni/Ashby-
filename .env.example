# Copy this file to .env (cp .env.example .env) and fill in your values.
# .env is git-ignored. NEVER commit it or paste tokens in Slack.

# Hugging Face "Read" token: huggingface.co -> Settings -> Access Tokens -> New token (type: Read).
# You must also click "Agree / request access" on each model page and wait until it says approved.
HF_TOKEN=

# NCSA Lumen API key: from the Lumen web page / hackathon organizers.
LUMEN_API_KEY=

# Lumen API address (ends in something like /v1). Ask organizers or check the Lumen docs.
LUMEN_BASE_URL=

# Which Lumen model to use. Leave empty and run scripts/check_setup.py to list available models.
LUMEN_MODEL=

# Folder with slides/tiles. On Delta, ask organizers for the preloaded data path. Locally: ./data
DATA_DIR=

# Folder with downloaded model weights. On Delta, ask organizers for the preloaded model path.
MODEL_DIR=

# Where Hugging Face saves downloaded models (several GB each). Optional.
# On Delta, point this at a big folder (ask organizers, e.g. your /projects or /work space),
# because your home folder is small. Leave empty on a laptop.
HF_HOME=
